{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hypervisor",
  "version": "0.1.0",
  "identifier": "dev.hypervisor.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "HYPERVISOR",
        "width": 1200,
        "height": 480,
        "decorations": false,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png", "icons/icon.icns"]
  }
}
